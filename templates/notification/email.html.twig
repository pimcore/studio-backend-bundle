{# Mirrors the bell entry: title, message, deep link — nothing from the payload. #}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
</head>
<body style="margin: 0; padding: 0;">
    <div style="font-family: Arial, Helvetica, sans-serif; color: #1f1f1f; line-height: 1.5;">
        <p>{{ 'notifications.email.greeting'|trans({'%name%': name}, 'studio', locale) }}</p>

        <h2 style="margin: 0 0 8px; font-size: 18px;">{{ title }}</h2>

        {% if message is not empty %}
            <p style="margin: 0 0 20px;">{{ message|nl2br }}</p>
        {% endif %}

        <p style="margin: 0 0 24px;">
            <a href="{{ link }}"
               style="display: inline-block; padding: 10px 18px; background: #3d1e75; color: #ffffff;
                      text-decoration: none; border-radius: 6px; font-weight: bold;">
                {{ 'notifications.email.cta'|trans({}, 'studio', locale) }}
            </a>
        </p>

        <hr style="border: none; border-top: 1px solid #e0e0e0; margin: 24px 0;">

        <p style="font-size: 12px; color: #8c8c8c; margin: 0;">
            {{ 'notifications.email.footer'|trans({}, 'studio', locale) }}
        </p>
    </div>
</body>
</html>
