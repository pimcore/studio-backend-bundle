{
  "name": "pimcore/studio-backend-bundle",
  "license": "proprietary",
  "type": "pimcore-bundle",
  "description": "Pimcore Studio Backend Bundle",
  "config": {
    "discard-changes": true,
    "sort-packages": true,
    "preferred-install": {
      "pimcore/pimcore": "source",
      "*": "dist"
    },
    "allow-plugins": {
      "php-http/discovery": false
    }
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": "~8.4.0 || ~8.5.0",
    "league/csv": "^9.27",
    "league/oauth2-server": "^9.0",
    "nesbot/carbon": "^3.10.0",
    "pimcore/static-resolver-bundle": "^2026.2.0",
    "pimcore/generic-data-index-bundle": "^2026.2.0",
    "pimcore/pimcore": "^2026.3",
    "zircote/swagger-php": "^5.0",
    "ext-zip": "*",
    "symfony/mercure": "^0.6.5",
    "symfony/mercure-bundle": "^0.3.9",
    "lcobucci/jwt": "^5.3",
    "phpdocumentor/reflection-docblock": "^5.6 || ^6.0",
    "phpoffice/phpspreadsheet": "^3.3|^4.0|^5.0",
    "ext-intl": "*",
    "ext-filter": "*",
    "twig/intl-extra": "^3.3.5",
    "twig/string-extra": "^3.11",
    "php-http/discovery": "^1.20",
    "psr/http-factory": "^1.0",
    "symfony/psr-http-message-bridge": "^7.4"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "codeception/codeception": "^5.3.5",
    "codeception/stub": "^4.3.0",
    "codeception/module-symfony": "^3.5",
    "codeception/module-asserts": "^2",
    "phpstan/phpstan": "2.1.26",
    "phpstan/phpstan-symfony": "^2.0.2",
    "phpunit/phpunit": "^12.5.23 || ^13.1.7",
    "nyholm/psr7": "^1",
    "symfony/phpunit-bridge": "^6",
    "fakerphp/faker": "^1.23"
  },
  "autoload": {
    "psr-4": {
      "Pimcore\\Bundle\\StudioBackendBundle\\": "src/",
      "Pimcore\\": "core-extension/Pimcore/"
    }
  },
  "conflict": {
    "zircote/swagger-php": ">=5.6"
  },
  "autoload-dev": {
    "psr-4": {
      "Pimcore\\Bundle\\StudioBackendBundle\\Tests\\": "tests"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-2026.x": "2026.1.x-dev"
    },
    "pimcore": {
      "bundles": [
        "Pimcore\\Bundle\\StudioBackendBundle\\PimcoreStudioBackendBundle"
      ]
    }
  }
}
